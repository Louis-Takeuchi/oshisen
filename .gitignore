# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# Publication-rule PDF review files (the distributed PDF is tracked in public/)
/tmp/pdfs/publication-rules/
/output/pdf/oshisen-candidate-publication-rules-2026.pdf

# 掲載データ入力シートのCSV書き出し（候補者の実データ・下書き解説を含むため、
# 公開済みの questions.csv 以外はコミットしない。取り込みは scripts/import-sheet-data.mjs）
/data/sheet/*.csv
!/data/sheet/questions.csv
